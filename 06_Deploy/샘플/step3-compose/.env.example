# 이 파일을 복사해 같은 폴더에 ".env" 로 저장한 뒤 값을 바꿔 쓰세요.
#   PowerShell :  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
# docker compose 는 같은 폴더의 .env 를 자동으로 읽어 docker-compose.yml 의 ${...} 에 채워 넣습니다.
#
# ⚠️ .env 에는 진짜 비밀번호가 들어가므로 Git 에 올리지 않습니다. (.gitignore 에 등록되어 있음)
#    .env.example 에는 "예시 값"만 두고, 이 파일만 공유합니다.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=intro
MYSQL_PASSWORD=change-me
