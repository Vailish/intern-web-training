# =========================================================
#  [STEP 1 - 심화] 멀티스테이지 Dockerfile
#  - jar 빌드까지 Docker 안에서 합니다. → 내 PC에 JDK/Gradle이 없어도, 누가 빌드해도 결과가 같습니다.
#  - STEP 2, 3 의 앱 Dockerfile 은 이 방식을 기본으로 씁니다.
#
#  빌드:  docker build -f Dockerfile.multistage -t intro-h2:multi .
# =========================================================

# ---------- 1단계: 빌드 스테이지 (JDK로 컴파일) ----------
FROM eclipse-temurin:17-jdk AS build
WORKDIR /workspace

# 빌드에 필요한 파일만 복사
COPY gradlew settings.gradle build.gradle ./
COPY gradle gradle
COPY src src

# Windows에서 편집되어 줄바꿈이 CRLF가 된 gradlew 도 실행되도록 \r 제거 + 실행 권한 부여
# 테스트는 생략(-x test)해 빌드 시간을 줄입니다. (테스트는 CI에서 돌리는 것이 정석)
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew \
 && ./gradlew bootJar -x test --no-daemon

# ---------- 2단계: 실행 스테이지 (JRE만) ----------
FROM eclipse-temurin:17-jre
WORKDIR /app
# ⚠️ 함정: 컨테이너의 기본 시간대는 UTC 라서, 그대로 두면 작성 시각이 한국보다 9시간 느리게 저장·표시됩니다.
#    자바(JVM)는 TZ 환경변수를 읽어 기본 시간대를 정하므로 한국 시간으로 지정합니다.
ENV TZ=Asia/Seoul

RUN useradd -r -s /bin/false spring

# 1단계(build)에서 만든 jar "만" 가져옵니다. 소스·JDK·Gradle 캐시는 최종 이미지에 들어가지 않습니다.
COPY --from=build /workspace/build/libs/intro-0.0.1-SNAPSHOT.jar app.jar

RUN mkdir -p /app/data && chown -R spring:spring /app
USER spring

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
