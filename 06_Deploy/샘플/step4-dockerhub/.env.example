# 이 파일을 복사해 같은 폴더에 ".env" 로 저장한 뒤 값을 바꿔 쓰세요.
#   PowerShell :  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# ⚠️ .env 는 Git 에 올리지 않습니다. (.gitignore 에 등록되어 있음)

# ① 이미지를 받아올 Docker Hub 사용자명 (내 것 또는 짝꿍 것)
#    → 실제로 받는 이미지:  <DOCKERHUB_USER>/intro-app:1.0 , <DOCKERHUB_USER>/intro-db:1.0
#    Docker Hub 계정 없이 로컬 레지스트리로 연습할 때는:  DOCKERHUB_USER=localhost:5000/study
DOCKERHUB_USER=your-dockerhub-id

# ② 받아올 태그 (생략하면 1.0). 새 버전을 올렸다면 여기만 바꾸고 docker compose up -d
APP_TAG=1.0
DB_TAG=1.0

# ③ DB 비밀번호 — 이미지 안에는 없고, 실행하는 쪽에서 넣어 줍니다.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=intro
MYSQL_PASSWORD=change-me
